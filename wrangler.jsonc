// Cloudflare Worker for the store. See README.md for first-time setup.
{
  "name": "bonluxe",
  "main": "src/worker.js",
  "compatibility_date": "2026-10-01",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    // The Worker renders the storefront pages itself and passes /assets/* and /admin/* on to the static files.
    "run_worker_first": true
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "bonluxe",
      // Create it with: npx wrangler d1 create bonluxe   then paste the database_id it prints over the zeros.
      "database_id": "00000000-0000-0000-0000-000000000000",
      "migrations_dir": "migrations"
    }
  ],
  // The store's public address. www.bonluxe.store and the workers.dev address redirect here, and it is used
  // for canonical links, the sitemap and Google's structured data.
  // Leave it empty until the domain is connected: the store then answers on its workers.dev address.
  // Once bonluxe.store is on this Cloudflare account (nameservers pointed to Cloudflare at the registrar),
  // set "SITE_URL": "https://bonluxe.store" and uncomment the routes below.
  "vars": { "SITE_URL": "" },
  // "routes": [
  //   { "pattern": "bonluxe.store", "custom_domain": true },
  //   { "pattern": "www.bonluxe.store", "custom_domain": true }
  // ],
  // Still reachable at https://bonluxe.<your-subdomain>.workers.dev (it redirects to SITE_URL).
  "workers_dev": true,
  // Photo uploads from the admin need R2, which Cloudflare only turns on once a payment card is on the account
  // (the first 10 GB stay free). Until then, product photos can be links. To turn uploads on:
  //   npx wrangler r2 bucket create bonluxe-images
  // then add:  "r2_buckets": [{ "binding": "IMAGES", "bucket_name": "bonluxe-images" }],
  "observability": { "enabled": true }
}
